# =============================================================================
# Datanique — backend configuration
#
# Copy to `.env` in this `backend/` folder and uncomment what you need. Every
# setting has a safe default; an empty .env works. Keys are read by
# app/config.py (prefix DV_).
# =============================================================================

# ----- Network -----------------------------------------------------------------
# DV_BIND_HOST=127.0.0.1        # loopback only (recommended)
# DV_BIND_PORT=8000
# DV_ALLOWED_HOSTS=             # extra Host names accepted on loopback (comma list)
# DV_API_TOKEN=                 # scripted access: send as X-API-Token (required if not loopback)
# DV_ADMIN_TOKEN=               # guards admin endpoints (X-Admin-Token)
# DV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Storage -----------------------------------------------------------------
# DV_DATA_DIR=./data            # SQLite store, vault.json, diff stores, uploads
# DV_SQLITE_URL=                # default: <data dir>/data_validator.db

# ----- Vault (master password) -------------------------------------------------
# Saved passwords, history, diffs and templates are encrypted with the vault.
# Set this only for unattended servers; desktop users type the password or
# use "Remember on this computer".
# DV_VAULT_PASSWORD=
# Legacy key of versions before 0.3 — read once to migrate old passwords:
# DV_ENCRYPTION_KEY=
# DV_SECRET_KEY_FILE=.secret_key

# ----- Compare engine ----------------------------------------------------------
# DV_MAX_PARALLEL_COMPARES=3     # compares running at the same time
# DV_PUSHDOWN_MIN_ROWS=20000000  # same-connection tables this big are diffed in the database
# DV_MAX_UPLOAD_MB=20480
# DV_DUCKDB_MEMORY_LIMIT=        # e.g. 8GB or 70%; spills to disk (encrypted) beyond it
# DV_DUCKDB_THREADS=0            # 0 = all cores
# Reader order per database (names: duckdb_postgres, duckdb_mysql,
# adbc_postgres, adbc_mssql, adbc_mysql, adbc_snowflake, arrow_odbc,
# connectorx, oracle_arrow, snowflake_arrow, cursor):
# DV_READER_ORDER_SQLSERVER=adbc_mssql,arrow_odbc,cursor
# DV_READER_ORDER_POSTGRES=duckdb_postgres,adbc_postgres,cursor

# ----- Connections -------------------------------------------------------------
# DV_CONNECT_TIMEOUT=30
# DV_TEST_TIMEOUT=30
# DV_QUERY_TIMEOUT=0             # seconds; 0 = no limit
# DV_KEEPALIVE_MINUTES=5
# DV_HEARTBEAT_SECONDS=240
# DV_CONNECT_RETRIES=2
